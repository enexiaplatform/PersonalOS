      "html": "<nav class=\"ds-nav\"><button class=\"ds-selected\" aria-current=\"page\">Tổng quan</button><button>Lịch công việc</button></nav>",
      "css": ".ds-nav{background:#f1f2f6;padding:10px;width:192px}.ds-nav button{display:block;text-align:left;width:100%;font:400 12px/1.5 var(--os-font,sans-serif);min-height:38px;padding:9px 10px;margin:3px 0;border:1px solid transparent;border-radius:6px;background:none;color:#565e70;cursor:pointer}.ds-nav button:hover{background:#e8eaf0;color:var(--os-ink,#202534)}.ds-nav .ds-selected{background:#e4dcef;color:#593b85;font-weight:700}.ds-nav button:focus-visible{outline:2px solid var(--accent,#7250a3);outline-offset:3px}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "description": "Quiet bordered surface with a compact title.",
      "html": "<section class=\"ds-panel\"><h2>Phân bổ công việc</h2><p>Số task từ nguồn tuần · không phải tỷ lệ hoàn thành.</p></section>",
      "css": ".ds-panel{padding:20px;border:1px solid var(--os-line,#e3e6ed);border-radius:12px;background:#fff;color:var(--os-ink,#202534);box-shadow:0 2px 6px #20253404;font-family:var(--os-font,sans-serif)}.ds-panel h2{font-size:15px;font-weight:700;letter-spacing:-.2px;margin:0 0 16px}.ds-panel p{font-size:10px;color:var(--os-muted,#626b7c);margin:14px 0 0}@media(max-width:760px){.ds-panel{padding:16px}}",
