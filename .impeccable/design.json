      "html": "<button class=\"ds-primary\">Lưu</button>",
      "css": ".ds-primary{font:400 12px/1.4 var(--os-font,sans-serif);min-height:34px;border-radius:6px;padding:8px 12px;cursor:pointer;transition:background-color .16s,border-color .16s,color .16s;background:var(--accent,#7250a3);color:#fff;border:1px solid var(--accent,#7250a3)}.ds-primary:hover{background:var(--accent-hover,#5e3e8b);border-color:var(--accent-hover,#5e3e8b)}.ds-primary:focus-visible{outline:2px solid var(--accent,#7250a3);outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(max-width:760px){.ds-primary{min-height:40px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
      "refersTo": "button-primary"
