  "narrative": {
    "northStar": "Nocturne Command",
    "overview": "Nocturne Command is a midnight working environment with layered blue surfaces, violet and indigo actions, cyan keyboard focus and restrained atmospheric depth. A compact twilight mountain hero gives home a recognizable identity; real task lists, source facts, charts and utilities remain interactive UI.\n\nThe user’s detailed Nocturne mission supersedes the previous Studio and light-system restrictions, including prohibitions on gradients and atmospheric artwork. No reference image was actually available in this session: the implementation follows the supplied textual mission and must not be described as verified visual fidelity to an unseen image.",
    "keyCharacteristics": [
      "Midnight navigation and layered dark working surfaces",
      "Self-hosted Noto Sans with Vietnamese coverage",
      "Four truthful weekly count cards and visible source caveats",
      "Interactive today tasks, status distribution and dated observation timeline",
      "Existing AI Manager integration and a real local focus timer"
    ],
    "rules": [
      {
        "name": "The Selective Light Rule",
        "body": "Use gradient and bright accent for hierarchy; keep ordinary information panels calm and avoid glowing every boundary.",
        "section": "colors"
      },
      {
        "name": "The Working Depth Rule",
